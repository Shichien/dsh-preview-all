{
  "name": "dsh-preview-all-in-one",
  "version": "0.2.0",
  "description": "DSH plugin: one right-Sidebar preview for every file DSH's builtin previews leave to 'binary file, download' — video and audio, archives, fonts, camera raw, HEIC/AVIF, RTF/ODF documents, and any other binary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shichien/dsh-preview-all.git"
  },
  "homepage": "https://github.com/Shichien/dsh-preview-all#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "pretest": "node scripts/build-client.mjs --check",
    "stress": "node test/stress/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
